PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Neon pooled connection for normal requests; never place in public/.
DATABASE_URL=
# Neon direct connection for migrations.
DATABASE_URL_UNPOOLED=
PAYMENT_MODE=simulation
SUPPLIER_MODE=simulation
# Opt-in local PostgreSQL development fallback. Production refuses this setting.
LOCAL_DEMO=false
# Set only when running npm run admin:create; not a default login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
