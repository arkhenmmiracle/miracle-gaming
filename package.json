{
  "name": "miracle-topup",
  "version": "1.0.0",
  "description": "HTML storefront and Node.js backend for a Neon-backed game top-up portfolio",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "admin:create": "node --env-file-if-exists=.env db/admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "demo:init": "LOCAL_DEMO=true node db/migrate.js && LOCAL_DEMO=true node db/seed.js",
    "demo": "LOCAL_DEMO=true node src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0"
  }
}
